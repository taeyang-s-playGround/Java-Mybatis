<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Sign Up</title>
</head>
<body>
<h1>Sign Up</h1>
<form action="/users/signup" method="post">
    Username: <input type="text" name="username" /><br/>
    Account ID: <input type="text" name="accountId" /><br/>
    Password: <input type="password" name="password" /><br/>
    <button type="submit">Sign Up</button>
</form>
</body>
</html>
