<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="spring.Java_MyBatis.domain.mapper.UserMapper">

    <!-- 공통 컬럼 정의 -->
    <sql id="userColumns">
        id, username, account_id, password
    </sql>

    <!-- 유저 저장 -->
    <insert id="save" useGeneratedKeys="true" keyProperty="user.id">
        INSERT INTO users (username, account_id, password)
        VALUES (#{user.username}, #{user.accountId}, #{user.password})
    </insert>

    <!-- 전체 유저 조회 -->
    <select id="getAllUsers" resultType="spring.Java_MyBatis.domain.entity.User">
        SELECT <include refid="userColumns" /> FROM tbl_user
    </select>

    <!-- 유저명으로 조회 -->
    <select id="findByUserName" resultType="spring.Java_MyBatis.domain.entity.User">
        SELECT <include refid="userColumns" /> FROM tbl_user WHERE username = #{user.username}
    </select>

</mapper>
